#include <iostream>
#include <cstdlib>
#include <ctime>

void print3D(double*** arr, int d1, int d2, int d3) {
    for (int i = 0; i < d1; ++i) {
        std::cout << "Block " << i << ":\n";
        for (int j = 0; j < d2; ++j) {
            for (int k = 0; k < d3; ++k) {
                std::cout << arr[i][j][k] << " ";
            }
            std::cout << "\n";
        }
        std::cout << "\n";
    }
}

int main() {
    std::srand(std::time(nullptr));

    int d1 = 2, d2 = 3, d3 = 4;

    double*** array3D = new double**[d1];
    for (int i = 0; i < d1; ++i) {
        array3D[i] = new double*[d2];
        for (int j = 0; j < d2; ++j) {
            array3D[i][j] = new double[d3];
        }
    }

    for (int i = 0; i < d1; ++i) {
        for (int j = 0; j < d2; ++j) {
            for (int k = 0; k < d3; ++k) {
                array3D[i][j][k] = (std::rand() % 100) + 0.5;
            }
        }
    }

    print3D(array3D, d1, d2, d3);

    for (int i = 0; i < d1; ++i) {
        for (int j = 0; j < d2; ++j) {
            delete[] array3D[i][j];
        }
        delete[] array3D[i];
    }
    delete[] array3D;

    return 0;
}
